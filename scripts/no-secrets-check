#!/usr/bin/env python3
"""Refuse secret-looking or instance-identifying strings in this public repository.

usage: scripts/no-secrets-check            # every git-tracked file
       scripts/no-secrets-check --staged   # files staged for commit (pre-commit hook)
       scripts/no-secrets-check --stdin    # scan stdin, e.g. `git log -p | scripts/no-secrets-check --stdin`

Generic patterns live below. Instance-specific ones (your hostnames, domains, user names)
go into `.no-secrets-local` at the repo root — one regex per line — which is gitignored,
because the patterns themselves would reveal the instance.
"""
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SELF = os.path.relpath(os.path.abspath(__file__), HERE)
SKIP = {SELF, ".no-secrets-local"}

GENERIC = [
    ("outline api key", r"ol_api_[A-Za-z0-9]{16,}"),
    ("openai/anthropic key", r"\bsk-[A-Za-z0-9_-]{20,}"),
    ("github token", r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"),
    ("aws access key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("private key block", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("bearer token", r"Bearer [A-Za-z0-9._~+/=-]{24,}"),
    ("jwt", r"\beyJ[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{8,}"),
    ("credential assignment",
     r"(?i)[A-Za-z0-9_.-]*(?:password|passwd|secret|token|api[_-]?key|private[_-]?key)\s*[:=]\s*['\"]?(?=[A-Za-z_\-]*[0-9/+=])[A-Za-z0-9_\-/+=]{16,}"),
    ("rfc1918 10/8", r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b"),
    ("rfc1918 192.168/16", r"\b192\.168\.\d{1,3}\.\d{1,3}\b"),
    ("rfc1918 172.16/12", r"\b172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}\b"),
    ("cgnat 100.64/10", r"\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b"),
    (".lan hostname", r"\.lan\b"),
    ("gmail address", r"@gmail\.com"),
]


def load_local():
    path = os.path.join(HERE, ".no-secrets-local")
    if not os.path.exists(path):
        return []
    out = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#"):
                out.append(("local: " + line, line))
    return out


def files(mode):
    if mode == "--staged":
        cmd = ["git", "diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR"]
    else:  # tracked + untracked (not ignored), so a fresh checkout is scanned before its first commit
        cmd = ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"]
    raw = subprocess.run(cmd, cwd=HERE, capture_output=True, check=True).stdout.decode()
    return [f for f in raw.split("\0") if f and f not in SKIP]


def scan_text(text, label, patterns, hits):
    for lineno, line in enumerate(text.splitlines(), 1):
        for name, rx in patterns:
            if rx.search(line):
                hits.append("%s:%d: %s" % (label, lineno, name))


def main(argv):
    mode = argv[1] if len(argv) > 1 else "--tracked"
    if mode not in ("--tracked", "--staged", "--stdin"):
        print(__doc__)
        return 2
    patterns = [(n, re.compile(p)) for n, p in GENERIC + load_local()]
    hits = []
    if mode == "--stdin":
        scan_text(sys.stdin.read(), "<stdin>", patterns, hits)
    else:
        for rel in files(mode):
            path = os.path.join(HERE, rel)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, encoding="utf-8") as fh:
                    scan_text(fh.read(), rel, patterns, hits)
            except UnicodeDecodeError:
                continue  # binary file
    if hits:
        print("no-secrets-check: refusing — %d hit(s):" % len(hits))
        for h in hits:
            print("  " + h)
        return 1
    print("no-secrets-check: clean (%d generic + %d local patterns)" % (len(GENERIC), len(patterns) - len(GENERIC)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
